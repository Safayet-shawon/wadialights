{
  "name": "wadia-lights",
  "version": "1.0.0",
  "description": "WADIA — Lights & Automation: cinematic landing site, lighting planner, catalogue and enquiry API (Vite + Node + PostgreSQL/Supabase).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test \"server/test/*.test.js\"",
    "test:e2e": "node tools/test-features.mjs desktop && node tools/test-features.mjs mobile",
    "db:migrate": "node scripts/migrate.mjs",
    "render": "node tools/render-all.mjs",
    "assets": "node tools/make-assets.mjs",
    "docker": "docker compose up --build"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "pg": "^8.23.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.13.0",
    "vite": "^8.3.4"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
