# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.

# PostgreSQL / Supabase. Use the POOLED connection string (Supabase: Project Settings → Database →
# Connection pooling, "Transaction" mode, port 6543). Leave empty to run with the demo catalogue only.
POSTGRES_URL=

# Salt for hashing client IPs before they are stored with an enquiry (any long random string).
IP_SALT=change-me

# Max connections per app instance (serverless defaults to 3, servers to 10).
DB_POOL_MAX=

# Docker/Node server only
PORT=3000
